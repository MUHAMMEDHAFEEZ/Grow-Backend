# Django
DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_DEBUG=True
DJANGO_LOG_LEVEL=INFO
ALLOWED_HOSTS=localhost,127.0.0.1

# Redis (optional — falls back to LocMemCache if unavailable)
REDIS_URL=redis://localhost:6379/1
CACHE_BACKEND=redis          # Set to "locmem" to bypass Redis entirely

# Celery (requires Redis)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Database (defaults to SQLite)
DATABASE_URL=sqlite:///db.sqlite3

# Email
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@grow-platform.io

# Google OAuth
GOOGLE_OAUTH_CLIENT_ID=your-google-client-id

# Google Gemini AI (for student AI chat)
AI_API_KEY=your-google-gemini-api-key
AI_MODEL_NAME=gemini-3.5-flash

# PostgreSQL example (uncomment and fill in for production)
# DATABASE_URL=postgres://user:password@localhost:5432/grow
